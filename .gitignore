# .NET
bin/
obj/
*.user
*.suo
*.cache
*.log

# Python
__pycache__/
.pytest_cache/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

.fake
# Signing material and credentials. Nothing here is currently committed; these rules exist so
# a stray `git add -A` cannot be the moment it happens.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
signing.key

# Local and per-deployment configuration. appsettings.json holds structure and safe defaults
# and is committed; anything carrying a real connection string, JWT key or credential is not.
appsettings.Production.json
appsettings.*.local.json
.env
.env.*
# Anything ending in .env, not only a file called exactly that. deploy/*.env.example tells
# people to copy the template to api.env and web.env, and those filled-in copies carry the
# database password, the JWT key and the Resend API key. `.env` alone does not match them.
*.env
!*.env.example

# Build artefacts. Android build/ output is already ignored, but an APK copied elsewhere for
# distribution is not, and a signed pilot build is a redistributable credential-bearing binary.
*.apk
# …except the one the portal hands out. Zazi is not on Play yet, so /download serves this
# build, and a rule meant to keep build output out of the repository was silently dropping
# the one artefact that has to be in it — the page deployed, the file did not, and the link
# answered a redirect to sign-in.
!src/Zazi.Web/wwwroot/download/zazi.apk
*.aab
*.idsig

# Database backups, if anyone points backup-database.sh inside the working tree. They contain
# every user record and every piece of transaction evidence in the pilot.
zazi-backups/
*.backup
