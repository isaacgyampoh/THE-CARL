@using Microsoft.AspNetCore.Components.Authorization

@* <header>/<nav> rather than divs, so a screen reader can announce the banner and the
   navigation as landmarks and skip between them. *@
<header class="nav">
    @* The mark and the word, not the word alone. An agent who sees the handset and the
       portal in the same afternoon should be looking at one product; until now the phone had
       a drawn mark and the portal had bold text. *@
    <a class="brand" href="/">
        <ZaziMark Size="20" />
        <span>Zazi</span>
    </a>

    <AuthorizeView>
        <Authorized>
            @* NavLink sets aria-current="page" on the active link, which tells a screen
               reader which page this is and drives the underline in app.css. Match.All on
               "/" stops Today staying highlighted on every page, since every path starts
               with it. *@
            <nav class="links" aria-label="Sections">
                <NavLink href="/" Match="NavLinkMatch.All">Today</NavLink>
                <NavLink href="/held">Held</NavLink>
                <NavLink href="/team">Team</NavLink>
                <NavLink href="/float">Cash &amp; float</NavLink>
                <NavLink href="/operations">Operations</NavLink>
            </nav>
            <span class="who">@context.User.Identity?.Name</span>
            @* A form post, because signing out must clear the cookie on a real response. *@
            <form method="post" action="/auth/sign-out">
                <AntiforgeryToken />
                <button type="submit" class="link">Sign out</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>
