@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

@* First thing focus reaches, so a keyboard user can jump past the navigation instead of
   tabbing through it on every page. Hidden until focused — see .skip in app.css. *@
<a class="skip" href="#content">Skip to content</a>

<AuthorizeView>
    <Authorized>
        @* Sidebar and page side by side on a desktop; stacked on a phone. *@
        <div class="app-shell">
            <NavMenu />
            <div class="app-main">
                @* Find a customer from any page: the question asked most at a counter. *@
                <header class="topbar">
                    <form method="get" action="/transactions" role="search">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
                        <label for="global-search" class="visually-hidden">Search by customer number</label>
                        <input id="global-search" name="customer" type="search" inputmode="tel" autocomplete="off"
                               placeholder="Search a customer number…" />
                        <input type="hidden" name="period" value="ThisYear" />
                    </form>
                    <span class="today">@DateTimeOffset.UtcNow.ToString("dddd") · <strong>@DateTimeOffset.UtcNow.ToString("d MMMM yyyy")</strong></span>
                </header>
                <main id="content" tabindex="-1">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Signed out: sign in, sign up, reset. The first thing a new owner sees, so it says
           what Zazi is before asking for anything — and shows it: a balance card of the kind
           the portal is built around. On a phone the panel is a band above the form. *@
        <div class="auth-shell">
            <aside class="auth-art">
                <div class="auth-art-inner">
                    <a class="auth-brand" href="/sign-in">
                        <span class="brand-tile"><ZaziMark Size="18" /></span>
                        <span>Zazi</span>
                    </a>

                    <p class="auth-headline">Run your mobile money business with <em>every cedi</em> accounted for.</p>
                    <p class="auth-sub">
                        Cash, MTN, Telecel and AirtelTigo float, every agent and every transaction —
                        in one place. Agents on keypad phones record by SMS.
                    </p>

                    @* The product shown rather than described. Illustrative figures. *@
                    <div class="auth-preview" aria-hidden="true">
                        <div class="pv-card">
                            <span class="pv-label">Money on hand</span>
                            <span class="pv-amount">₵48,250.00</span>
                            <div class="pv-split">
                                <span><i class="dot cash"></i>Cash ₵12,400</span>
                                <span><i class="dot mtn"></i>MTN ₵26,150</span>
                                <span><i class="dot telecel"></i>Telecel ₵9,700</span>
                            </div>
                        </div>
                        <div class="pv-row">
                            <span class="net-badge mtn">MTN</span>
                            <span class="pv-what"><b>Cash out</b><small>024 412 3456 · 11:50</small></span>
                            <span class="pv-amt">−₵50.00</span>
                        </div>
                        <div class="pv-row">
                            <span class="net-badge telecel">T</span>
                            <span class="pv-what"><b>Cash in</b><small>020 555 1234 · 11:42</small></span>
                            <span class="pv-amt in">+₵300.00</span>
                        </div>
                    </div>

                    <ul class="auth-points">
                        <li><b>Works offline</b> — the app syncs when there is data</li>
                        <li><b>Keypad phones</b> — agents record and close the day by SMS</li>
                        <li><b>Close the day</b> — shortages flagged the same evening</li>
                    </ul>
                </div>
            </aside>

            <main id="content" tabindex="-1">
                @Body
            </main>
        </div>
    </NotAuthorized>
</AuthorizeView>
