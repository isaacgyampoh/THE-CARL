@page "/sign-in"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Sign in · Zazi</PageTitle>

<div class="signin">
    @* The mark and the name, not a heading. These pages are reached by someone who is
       often locked out, on a phone, in a hurry — the product identity reassures them they
       are in the right place, but the heading below is what tells them what this page does.
       "Zazi" as the h1 said the same thing on all six of them. *@
    <div class="masthead">
        <ZaziMark Size="24" />
        <span class="wordmark">Zazi</span>
    </div>
    <h1 class="purpose">Sign in to your account</h1>

    @* A plain form post, not an interactive submit: the sign-in response is what writes the
       authentication cookie, and a Blazor circuit has already sent its headers. *@
    <form method="post" action="/auth/sign-in">
        <AntiforgeryToken />
        <label for="email">Email</label>
        @* Focus starts here: this page exists to be typed into, and an agent signing in
           on a phone should not have to tap the field first. *@
        <input id="email" name="email" type="email" autocomplete="username"
               inputmode="email" autofocus required />

        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />

        @if (Error is not null)
        {
            <p class="error" role="alert">@Error</p>
        }

        <button type="submit">Sign in</button>
    </form>

    <p><a href="/forgot-password">Forgot password?</a></p>

    <p>New to Zazi? <a href="/sign-up">Create an account</a></p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    // Both failures read the same, deliberately. Distinguishing "no such account" from
    // "wrong password" would let anyone test which addresses are registered.
    private string? Error => ErrorCode switch
    {
        "invalid" => "Email or password is incorrect.",
        "missing" => "Enter your email and password.",
        "expired" => "That form expired. Please try again.",
        _ => null
    };
}
