@page "/team"
@using Zazi.Application
@using Zazi.Application.Security
@using Zazi.Domain
@attribute [Authorize(Policy = ZaziPolicies.StaffManage)]
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthState
@inject IAuthService Auth
@inject IDeviceService Devices
@inject IDeviceEnrollmentService Enrollment
@inject IOrganizationService Organizations
@inject ICurrentUserContext CurrentUser
@inject ILogger<Team> Log
@inject Microsoft.Extensions.Options.IOptions<Zazi.Application.Keypad.SmsGatewayOptions> Sms
@using Microsoft.EntityFrameworkCore

@rendermode InteractiveServer

@* Interactive, because this page's buttons are @onclick handlers and a statically rendered
   page has no circuit to run them on. They rendered, they looked enabled, and clicking them
   did nothing at all — issuing an activation code, revoking a device, none of it worked.

   Safe here specifically because the page requires sign-in: the Blazor framework files sit
   behind the same deny-by-default policy as everything else, so an anonymous visitor cannot
   load them, but an authenticated one can. Verified rather than assumed — signed in,
   /_framework/blazor.web.js returns 200 and the circuit endpoint answers. *@

@* The owner's side of worker activation: create a worker, hand them a code, see their
   device, take it away again. Deliberately one page — these four things are one job, and
   splitting them across an admin section would make the common case (a new hire on Monday)
   a navigation exercise. *@

<PageTitle>Team · Zazi</PageTitle>

<h1>Team</h1>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

@if (_issuedCode is not null)
{
    @* Shown exactly once. The server stores only a hash and cannot produce this again, so
       the page says so plainly rather than letting an owner navigate away assuming they can
       come back for it. *@
    <section class="tile" role="status">
        <span class="label">Activation code for @_issuedForName</span>
        <span class="value"><code>@_issuedCode</code></span>
        <p class="muted">
            Give this to @_issuedForName now. It is shown once and cannot be recovered —
            generate a new one if it is lost. Expires @_issuedExpiry?.ToLocalTime().ToString("g").
        </p>
        @* Most agents work on a keypad phone with no internet. The same code links that phone
           by SMS, so the owner is told how, right where the code is. Shown only once a Zazi
           SMS number is configured — an instruction to text a number that does not exist yet
           would strand the agent. *@
        @if (!string.IsNullOrWhiteSpace(Sms.Value.InboundNumber))
        {
            <p class="keypad-hint">
                <strong>On a keypad phone?</strong> Text <code>ZAZI @_issuedCode</code> to
                <strong>@Sms.Value.InboundNumber</strong>. Then forward every MoMo message to that
                number to record it.
            </p>
        }
    </section>
}

<h2>Workers</h2>

@if (_users is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Access</th>
                <th scope="col">Branch</th>
                <th scope="col">Status</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in _users)
        {
            <tr class="@(user.IsActive ? "" : "muted-row")">
                <td data-label="Name">@user.FullName</td>
                <td data-label="Access">
                    @* The distinction the whole change rests on, stated rather than inferred
                       from a blank email column. *@
                    @(user.CredentialType == UserCredentialType.ActivationOnly
                        ? "Activation code"
                        : "Email and password")
                </td>
                <td data-label="Branch">@BranchName(user.BranchId)</td>
                <td data-label="Status">@(user.IsActive ? "Active" : "Disabled")</td>
                <td data-label="">
                    @if (user.CredentialType == UserCredentialType.ActivationOnly && user.IsActive)
                    {
                        <button class="link" @onclick="() => IssueCodeAsync(user)" disabled="@_busy">
                            Generate activation code
                        </button>
                    }
                </td>
            </tr>
        }
        @if (_users.Count == 0)
        {
            <tr><td colspan="5" class="muted">No one yet. Add your first worker below.</td></tr>
        }
        </tbody>
    </table>
}

<h2>Branches</h2>

@* Gated separately from the page itself. /team requires StaffManage, which a branch manager
   holds — but creating branches is BranchManage, which they do not. Without this the page's
   own permission would quietly grant a wider one. *@
<AuthorizeView Policy="@ZaziPolicies.BranchRead" Context="auth">
    <ul class="estate">
        @foreach (var branch in _branches ?? Array.Empty<BranchDto>())
        {
            <li>
                <span>@branch.Name</span>
                @* A missing location is not a figure, so it is not set in bold. *@
                @if (string.IsNullOrWhiteSpace(branch.Location))
                {
                    <span class="muted">No location set</span>
                }
                else
                {
                    <span>@branch.Location</span>
                }
            </li>
        }
        @if ((_branches?.Count ?? 0) == 0)
        {
            <li><span class="muted">No branches yet.</span></li>
        }
    </ul>
</AuthorizeView>

<AuthorizeView Policy="@ZaziPolicies.BranchManage" Context="auth">
    <p class="muted">
        A branch is a place you trade from. Every worker and every device belongs to one, and
        figures are reported per branch.
    </p>

    <EditForm Model="_newBranch" OnValidSubmit="CreateBranchAsync" FormName="add-branch">
        <p>
            <label for="branch-name">Branch name</label>
            <InputText id="branch-name" @bind-Value="_newBranch.Name" />
        </p>

        <p>
            <label for="branch-location">Location <span class="muted">(optional)</span></label>
            <InputText id="branch-location" @bind-Value="_newBranch.Location" />
        </p>

        <button id="add-branch-submit" type="submit" disabled="@_busy">Add branch</button>
    </EditForm>
</AuthorizeView>

<h2>Add a worker</h2>

<p class="muted">
    A worker does not need an email address or a password. Create them here, then give them
    an activation code to enter on their phone.
</p>

<EditForm Model="_newWorker" OnValidSubmit="CreateWorkerAsync" FormName="add-worker">
    @* No <AntiforgeryToken /> here. EditForm with a FormName emits one itself, and adding a
       second renders the hidden field twice — which posts the value twice, so the framework
       reads "token,token" and rejects the submission with a 400. A plain <form>, like the one
       on the sign-in page, does need the explicit tag. *@
    <p>
        <label for="worker-name">Full name</label>
        <InputText id="worker-name" @bind-Value="_newWorker.FullName" />
    </p>

    <p>
        <label for="worker-branch">Branch</label>
        <InputSelect id="worker-branch" @bind-Value="_newWorker.BranchId">
            <option value="">Choose a branch…</option>
            @foreach (var branch in SelectableBranches())
            {
                <option value="@branch.Id">@branch.Name</option>
            }
        </InputSelect>
    </p>

    <button type="submit" disabled="@_busy">Add worker</button>
</EditForm>

<h2>Devices</h2>

@if (_devices is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th scope="col">Device</th>
                <th scope="col">Branch</th>
                <th scope="col">Status</th>
                <th scope="col">Last seen</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var device in _devices)
        {
            var revoked = device.Status == DeviceStatus.Revoked;
            <tr class="@(revoked ? "muted-row" : "")">
                <td data-label="Device">@device.Name</td>
                <td data-label="Branch">@BranchName(device.BranchId)</td>
                <td data-label="Status">@(revoked ? "Revoked" : device.Status.ToString())</td>
                <td data-label="Last seen">@device.LastSeenAt.ToLocalTime().ToString("g")</td>
                <td data-label="">
                    @if (revoked)
                    {
                        <span class="muted">—</span>
                    }
                    else if (_confirmingRevokeOf == device.Id)
                    {
                        @* Two steps, in the page's own state rather than a browser confirm().
                           Revoking cuts a working phone off mid-shift and cannot be undone
                           from here — the worker needs a fresh code afterwards — so it should
                           not be one stray click away. In-component rather than JS interop so
                           the decision stays testable. *@
                        <span class="attention">Cut this device off?</span>
                        <button class="link" @onclick="() => RevokeAsync(device)" disabled="@_busy">
                            Yes, revoke
                        </button>
                        <button class="link" @onclick="CancelRevoke" disabled="@_busy">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button class="link" @onclick="() => ConfirmRevoke(device)" disabled="@_busy">
                            Revoke
                        </button>
                    }
                </td>
            </tr>
        }
        @if (_devices.Count == 0)
        {
            <tr><td colspan="5" class="muted">No devices activated yet.</td></tr>
        }
        </tbody>
    </table>

    <p class="muted">
        Revoking takes effect the next time that phone reaches Zazi. A phone that is switched
        off or out of signal keeps working until it reconnects, then loses access — it cannot
        be told sooner.
    </p>
}

@code {
    /// <summary>
    /// Records a failure and returns what the owner should see.
    /// </summary>
    /// <remarks>
    /// The screen deliberately shows no exception detail — it carries identifiers and internal
    /// state, and an owner can act on neither. What was missing is the other half: the detail
    /// was not written anywhere either, so a failure left no trace at all and "please try
    /// again" was the entire record of it. Now the exception goes to the log with a short
    /// reference the owner can quote, which ties their report to the actual stack trace.
    /// </remarks>
    private string Fail(Exception exception, string operation, string message)
    {
        var reference = Guid.NewGuid().ToString("N")[..8];
        Log.LogError(exception, "Team page: {Operation} failed. Reference {Reference}.", operation, reference);
        return $"{message} (reference {reference})";
    }

    [SupplyParameterFromForm(FormName = "add-branch")]
    private NewBranch _newBranch { get; set; } = new();

    private async Task CreateBranchAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            // Checked here as well as in the markup. The form was once shown to branch managers
            // because the view that hides it was not being compiled as a component; the rule
            // must hold even when the page around it is wrong.
            var principal = (await AuthState.GetAuthenticationStateAsync()).User;
            if (!(await AuthorizationService.AuthorizeAsync(principal, ZaziPolicies.BranchManage)).Succeeded)
            {
                _error = "Only the owner can add a branch.";
                return;
            }

            var created = await Organizations.CreateBranchAsync(
                new CreateBranchRequest(
                    CurrentUser.OrganizationId,
                    _newBranch.Name ?? string.Empty,
                    string.IsNullOrWhiteSpace(_newBranch.Location) ? null : _newBranch.Location));

            if (created is null)
            {
                _error = "That organization no longer exists.";
                return;
            }

            _newBranch = new NewBranch();
            await LoadAsync();
        }
        catch (ArgumentException exception)
        {
            // Validation messages are the caller's own words and safe to show.
            _error = exception.Message;
        }
        catch (DbUpdateException exception)
        {
            // Branch names are unique per organization. Saying so is more useful than a generic
            // failure, and reveals nothing the owner cannot already see in the list above.
            _error = Fail(exception, "creating a branch",
                $"A branch called \"{_newBranch.Name}\" already exists. Choose a different name.");
        }
        catch (Exception exception)
        {
            _error = Fail(exception, "creating a branch", "The branch could not be created. Please try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class NewBranch
    {
        public string? Name { get; set; }
        public string? Location { get; set; }
    }

    private sealed class NewWorker
    {
        public string FullName { get; set; } = string.Empty;
        public string BranchId { get; set; } = string.Empty;
    }

    // [SupplyParameterFromForm], like the branch form below it.
    //
    // Without it this form could never work. These pages render statically, so submitting one
    // rebuilds the component from scratch — a plain field comes back as a fresh, empty object
    // and whatever was typed is gone before the handler runs. BranchId was therefore always
    // blank, Guid.TryParse always failed, and every attempt to add a worker was refused with
    // "Choose a branch for this worker" no matter what had been chosen.
    //
    // It survived because the bUnit tests render interactively, where the field does persist.
    // Those tests passed against behaviour that could not happen in a browser.
    [SupplyParameterFromForm(FormName = "add-worker")]
    private NewWorker _newWorker { get; set; } = new();

    private IReadOnlyList<UserDto>? _users;
    private IReadOnlyList<DeviceDto>? _devices;
    private IReadOnlyList<BranchDto>? _branches;

    private string? _error;
    private bool _busy;

    // Which device is one click away from being revoked. Null means none, which is the only
    // state in which the destructive action is not reachable.
    private Guid? _confirmingRevokeOf;

    // Held only for this render. The plaintext exists nowhere else and is never stored.
    private string? _issuedCode;
    private string? _issuedForName;
    private DateTimeOffset? _issuedExpiry;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var organizationId = CurrentUser.OrganizationId;
            _branches = await Organizations.GetBranchesAsync(organizationId);

            // Scoped with the same rule the API endpoints use. Calling the services directly
            // skips the controllers, and the controllers were where this filtering used to
            // live — so without this a branch manager saw every worker and every device in
            // the business.
            _users = CurrentUser.LimitToVisibleBranch(
                await Auth.GetUsersAsync(organizationId), u => u.BranchId);
            _devices = CurrentUser.LimitToVisibleBranch(
                await Devices.GetDevicesAsync(organizationId), d => d.BranchId);
        }
        catch (Exception exception)
        {
            _error = Fail(exception, "loading the team", "The team could not be loaded. Please try again.");
        }
    }

    private async Task CreateWorkerAsync()
    {
        if (!Guid.TryParse(_newWorker.BranchId, out var branchId))
        {
            _error = "Choose a branch for this worker.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Auth.CreateWorkerAsync(
                new CreateWorkerRequest(
                    CurrentUser.OrganizationId,
                    branchId,
                    _newWorker.FullName,
                    new[] { ZaziRoles.Agent }));

            _newWorker = new NewWorker();
            await LoadAsync();
        }
        catch (ArgumentException exception)
        {
            // Validation messages are the caller's own words and safe to show.
            _error = exception.Message;
        }
        catch (Exception exception)
        {
            _error = Fail(exception, "creating a worker", "The worker could not be created. Please try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task IssueCodeAsync(UserDto worker)
    {
        if (worker.BranchId is not { } branchId)
        {
            _error = "This worker has no branch, so a code cannot be scoped to one.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var issued = await Enrollment.IssueCodeAsync(
                new IssueEnrollmentCodeRequest(branchId, DeviceRole.TransactionDevice, worker.Id),
                CurrentUser.OrganizationId,
                branchId,
                CurrentUser.UserId);

            _issuedCode = issued.Code;
            _issuedForName = worker.FullName;
            _issuedExpiry = issued.ExpiresAtUtc;
        }
        catch (Exception exception)
        {
            _error = Fail(exception, "issuing an activation code", "The activation code could not be generated. Please try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmRevoke(DeviceDto device) => _confirmingRevokeOf = device.Id;

    private void CancelRevoke() => _confirmingRevokeOf = null;

    private async Task RevokeAsync(DeviceDto device)
    {
        // Refuses to act on anything the owner has not just confirmed, so a stale render or a
        // duplicated event cannot revoke a device on its own.
        if (_confirmingRevokeOf != device.Id)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Devices.RevokeDeviceAsync(
                device.Id,
                CurrentUser.OrganizationId,
                CurrentUser.UserId,
                // The same scope the listing above uses, so a branch manager cannot revoke a
                // handset this page would never have shown them.
                CurrentUser.VisibleBranchId());
            _confirmingRevokeOf = null;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _error = Fail(exception, "revoking a device", "The device could not be revoked. Please try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    // A branch manager may only create workers in the branch they run. Offering them the
    // others would produce a rejection from the tenant guard after they had filled the form.
    private IEnumerable<BranchDto> SelectableBranches() =>
        (_branches ?? new List<BranchDto>())
            .Where(b => CurrentUser.CanAccessBranch(b.Id));

    private string BranchName(Guid? branchId) =>
        branchId is { } id
            ? _branches?.FirstOrDefault(b => b.Id == id)?.Name ?? "—"
            : "All branches";
}
