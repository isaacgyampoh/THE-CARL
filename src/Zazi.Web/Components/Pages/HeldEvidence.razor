@page "/held"
@using Zazi.Application
@using Zazi.Application.Security
@attribute [Authorize(Policy = ZaziPolicies.TransactionRead)]
@inject IObservabilityService Observability
@inject ICurrentUserContext CurrentUser

@rendermode InteractiveServer

@* Interactive, because this page's buttons are @onclick handlers and a statically rendered
   page has no circuit to run them on. They rendered, they looked enabled, and clicking them
   did nothing at all — issuing an activation code, revoking a device, none of it worked.

   Safe here specifically because the page requires sign-in: the Blazor framework files sit
   behind the same deny-by-default policy as everything else, so an anonymous visitor cannot
   load them, but an authenticated one can. Verified rather than assumed — signed in,
   /_framework/blazor.web.js returns 200 and the circuit endpoint answers. *@

<PageTitle>Held for review · Zazi</PageTitle>

<h1>Held for review</h1>

<p class="muted lead">
    Transactions Zazi observed but would not post on its own — a truncated message, an
    unrecognised template, anything without a provider reference. Nothing here has moved money.
</p>

@if (_failed)
{
    <p class="error" role="alert">The review queue could not be loaded.</p>
}
else if (_page is null)
{
    <p class="muted">Loading…</p>
}
else if (_page.Items.Count == 0)
{
    <p class="muted">Nothing is waiting for review.</p>
}
else
{
    <p class="muted">@_page.TotalCount waiting, oldest first.</p>

    <div class="scroll">
        <table>
            <thead>
            <tr>
                <th>Observed</th><th>Provider</th><th>Type</th><th class="n">Amount</th>
                <th>Reference</th><th>Why held</th><th class="n">Confidence</th><th>Age</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in _page.Items)
            {
                <tr class="@(item.AgeHours >= 24 ? "warn-row" : "")">
                    <td data-label="Observed">@item.ObservedAt.ToLocalTime().ToString("dd MMM HH:mm")<span class="sub">@item.SourceType</span></td>
                    <td data-label="Provider">@item.Provider</td>
                    <td data-label="Type">@item.TransactionType</td>
                    <td class="n" data-label="Amount">@Money(item.Amount, item.Currency)</td>
                    <td data-label="Reference">@(string.IsNullOrWhiteSpace(item.Reference) ? "—" : item.Reference)</td>
                    <td data-label="Why held">@item.OutcomeReason</td>
                    <td class="n" data-label="Confidence">@item.Confidence.ToString("0.00")</td>
                    <td data-label="Age">@(item.AgeHours < 1 ? "<1h" : $"{item.AgeHours}h")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (_page.TotalCount > PageSize)
    {
        <div class="pager">
            <button disabled="@(_pageNumber <= 1)" @onclick="Previous">Previous</button>
            <span class="muted">Page @_page.Page</span>
            <button disabled="@(!_page.HasMore)" @onclick="Next">Next</button>
        </div>
    }
}

@code {
    private PagedResult<HeldEvidenceDto>? _page;
    private int _pageNumber = 1;
    private bool _failed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _page = await Observability.GetHeldEvidenceAsync(
                CurrentUser.OrganizationId, _pageNumber, PageSize);
        }
        catch (Exception)
        {
            _failed = true;
        }
    }

    private async Task Next()
    {
        _pageNumber++;
        await LoadAsync();
    }

    private async Task Previous()
    {
        _pageNumber = Math.Max(1, _pageNumber - 1);
        await LoadAsync();
    }

    private const int PageSize = 25;

    private static string Money(decimal amount, string currency) =>
        currency == "GHS" ? $"₵{amount:N2}" : $"{amount:N2} {currency}";
}
