@page "/forgot-password"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.RateLimiting
@using Zazi.Application.Security
@using Zazi.Web.Security
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting(WebRateLimitPolicies.Recovery)]
@inject IPasswordResetService Reset

@* Reachable by people who cannot sign in, which is the whole point, so it is anonymous and
   rate limited by the same per-IP policy the sign-in endpoint uses. Static server rendering:
   nothing here needs a circuit, and a circuit is the worst dependency to add to the page
   somebody reaches when they are already locked out. *@

<PageTitle>Reset your password · Zazi</PageTitle>

<div class="signin">
    @* The mark and the name, not a heading. These pages are reached by someone who is
       often locked out, on a phone, in a hurry — the product identity reassures them they
       are in the right place, but the heading below is what tells them what this page does.
       "Zazi" as the h1 said the same thing on all six of them. *@
    <div class="masthead">
        <ZaziMark Size="24" />
        <span class="wordmark">Zazi</span>
    </div>

    @if (!Reset.IsAvailable)
    {
        <h1 class="purpose">Password reset is unavailable</h1>
        <p>
            This Zazi deployment is not set up to send password reset emails. Ask whoever
            administers it to reset your password for you.
        </p>
        <p><a href="/sign-in">Back to sign in</a></p>
    }
    else if (_submitted)
    {
        @* One message, always. It is identical whether or not the address has an account,
           because anything else turns this form into a way to discover who uses Zazi. *@
        <h1 class="purpose">Check your email</h1>
        <p>
            If <strong>@_enteredAddress</strong> has a Zazi account, a link to choose a new
            password is on its way.
        </p>
        <p class="muted">
            The link works once and expires shortly. If nothing arrives, check your spam folder
            before requesting another.
        </p>
        <p><a href="/sign-in">Back to sign in</a></p>
    }
    else
    {
        <h1 class="purpose">Reset your password</h1>
        <p>Enter the email address you sign in with and we will send you a link.</p>

        <EditForm Model="_input" OnValidSubmit="SubmitAsync" FormName="forgot-password">
    @* No <AntiforgeryToken /> here. EditForm with a FormName emits one itself, and adding a
       second renders the hidden field twice — which posts the value twice, so the framework
       reads "token,token" and rejects the submission with a 400. A plain <form>, like the one
       on the sign-in page, does need the explicit tag. *@
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="_input.Email" type="email"
                       autocomplete="email" />

            <button type="submit" disabled="@_busy">Send reset link</button>
        </EditForm>

        <p>Remembered it? <a href="/sign-in">Sign in</a></p>
    }
</div>

@code {
    [SupplyParameterFromForm(FormName = "forgot-password")]
    private ForgotPasswordInput _input { get; set; } = new();

    // Arrives from the sign-in page after a failed attempt, so the person who was just told to
    // reset does not have to type their address a second time.
    [SupplyParameterFromQuery(Name = "email")]
    private string? PrefilledEmail { get; set; }

    private bool _submitted;
    private bool _busy;
    private string? _enteredAddress;

    protected override void OnInitialized()
    {
        // Only on the first render. A POST brings the address the person actually submitted,
        // which must win over whatever was in the link.
        if (string.IsNullOrWhiteSpace(_input.Email) && !string.IsNullOrWhiteSpace(PrefilledEmail))
        {
            _input.Email = PrefilledEmail;
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            // No result to branch on, by design: the service returns nothing and takes the same
            // time either way. There is deliberately no validation branch here either — a
            // malformed address gets the same confirmation as a real one, because "that is not
            // a valid email" and "no account" are different messages and the difference is the
            // leak.
            await Reset.RequestResetAsync(_input.Email ?? string.Empty);

            _enteredAddress = _input.Email;
            _submitted = true;
            _input = new ForgotPasswordInput();
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ForgotPasswordInput
    {
        public string? Email { get; set; }
    }
}
