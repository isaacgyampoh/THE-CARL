@page "/"
@using Zazi.Application
@using Zazi.Application.Float
@using Zazi.Application.Security
@using Zazi.Domain
@using Microsoft.AspNetCore.Components.Authorization
@inject IDashboardService Dashboard
@inject IFloatService Float
@inject ITransactionService Transactions
@inject Zazi.Application.Closing.IDayCloseService Closes
@inject Zazi.Application.Growth.IFloatRequestService FloatRequests
@inject Zazi.Application.Growth.IInsightsService Insights
@inject Zazi.Application.Growth.IExpenseService Costs
@inject ICurrentUserContext CurrentUser
@inject AuthenticationStateProvider AuthState

<PageTitle>Today · Zazi</PageTitle>

@* A full page refresh, deliberately, rather than an interactive circuit with a timer.
   Revocation is enforced in RevokedSessionValidator, which runs when the cookie is
   validated — that is, on each HTTP request. A Blazor circuit establishes its principal
   once and holds it, so a revoked owner's open dashboard would go on serving live figures
   for as long as the circuit lived. Reloading keeps that guarantee intact: every refresh is
   a real request, and a revoked session is signed out on the next one.

   Only this page. Operations and Held are paged and filtered, and reloading them would
   throw away where the reader had got to. *@
<HeadContent>
    <meta http-equiv="refresh" content="@RefreshSeconds" />
</HeadContent>

<header class="page-head">
    <div>
        <p class="eyebrow">@DateTimeOffset.UtcNow.ToString("dddd, d MMMM")</p>
        <h1>@Greeting()@FirstName()</h1>
    </div>
    <div class="page-actions">
        @if (_summary is not null && !_failed)
        {
            @* Figures someone may act on say how old they are. *@
            <p class="asof-chip">
                <span class="live-dot" aria-hidden="true"></span>
                Updated @_readAt.ToString("HH:mm") · <a href="/">Refresh</a>
            </p>
        }
        <a class="btn btn-secondary" href="/transactions?period=Today">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14"/></svg>
            Statement
        </a>
        <a class="btn btn-primary" href="/float">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Give float
        </a>
    </div>
</header>

@if (_failed)
{
    <p class="error" role="alert">
        The dashboard could not be loaded. Nothing has been changed.
    </p>
}
else if (_summary is null)
{
    <p class="muted">Loading…</p>
}
else
{
    var today = _series.Count > 0 ? _series[^1] : null;
    var yesterday = _series.Count > 1 ? _series[^2] : null;
    var week = _series.TakeLast(7).ToList();
    var fortnight = _series.TakeLast(14).ToList();
    var monthStart = new DateOnly(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    var commissionThisMonth = _series.Where(d => d.Day >= monthStart).Sum(d => d.Commission);
    var shortCount = _closes.Count(c => c.Status == "Short");

    @* Things waiting on the owner, most urgent first. Only when there is something: rows that
       read "0" every day teach an owner to stop looking. *@
    @if (_floatRequests > 0 || shortCount > 0 || _summary.Discrepancies > 0 || _summary.LowFloatAlerts > 0)
    {
        <div class="alerts">
            @if (shortCount > 0)
            {
                <a class="alert bad" href="/closing">
                    <span class="alert-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 8v5M12 16.5v.5"/><circle cx="12" cy="12" r="9"/></svg></span>
                    <span class="alert-text"><strong>@shortCount @Plural(shortCount, "agent", "agents") closed short today</strong>Their count is less than what they recorded.</span>
                    <span class="alert-go">Review →</span>
                </a>
            }
            @if (_floatRequests > 0)
            {
                <a class="alert" href="/float">
                    <span class="alert-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>
                    <span class="alert-text"><strong>@_floatRequests float @Plural(_floatRequests, "request", "requests") waiting</strong>An agent without float is turning customers away.</span>
                    <span class="alert-go">Answer →</span>
                </a>
            }
            @if (_summary.Discrepancies > 0 || _summary.LowFloatAlerts > 0)
            {
                <a class="alert" href="/operations">
                    <span class="alert-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l9 16H3z"/><path d="M12 10v4M12 17v.5"/></svg></span>
                    <span class="alert-text">
                        <strong>Needs attention</strong>
                        @if (_summary.Discrepancies > 0) { <text>@_summary.Discrepancies @Plural(_summary.Discrepancies, "discrepancy", "discrepancies") to reconcile. </text> }
                        @if (_summary.LowFloatAlerts > 0) { <text>@_summary.LowFloatAlerts low float @Plural(_summary.LowFloatAlerts, "alert", "alerts").</text> }
                    </span>
                    <span class="alert-go">Open →</span>
                </a>
            }
        </div>
    }
    else
    {
        <p class="all-clear" role="status">
            <span aria-hidden="true">✓</span> Nothing needs attention — no shortages, no float requests, no discrepancies.
        </p>
    }

    <section class="kpis" aria-label="Key figures">
        <div class="kpi feature">
            <span class="label">Money on hand</span>
            <span class="value">@Cedis(TotalOnHand)</span>
            <div class="foot">
                <span class="note">Cash @Cedis(CashInHand) · float @Cedis(TotalOnHand - CashInHand)</span>
            </div>
        </div>
        <div class="kpi">
            <span class="label">Volume today</span>
            <span class="value">@Cedis(today?.Volume ?? 0)</span>
            <div class="foot">
                <span><Delta Now="today?.Volume ?? 0" Before="yesterday?.Volume ?? 0" /><span class="vs" aria-hidden="true">vs yesterday</span></span>
                <Sparkline Values="@week.Select(d => d.Volume).ToList()" Label="Volume, last 7 days" />
            </div>
        </div>
        <div class="kpi">
            <span class="label">Transactions today</span>
            <span class="value">@((today?.Transactions ?? 0).ToString("N0"))</span>
            <div class="foot">
                <span><Delta Now="today?.Transactions ?? 0" Before="yesterday?.Transactions ?? 0" /><span class="vs" aria-hidden="true">vs yesterday</span></span>
                <Sparkline Values="@week.Select(d => (decimal)d.Transactions).ToList()" Label="Transactions, last 7 days" />
            </div>
        </div>
        <div class="kpi">
            @* Commission is what was earned; this is what was kept, which is the figure an
               owner actually lives on. *@
            <span class="label">Profit this month</span>
            <span class="value">@Cedis(commissionThisMonth - _monthCosts)</span>
            <div class="foot">
                <span class="note">@Cedis(commissionThisMonth) earned · @Cedis(_monthCosts) costs</span>
                <Sparkline Values="@week.Select(d => d.Commission).ToList()" Label="Commission, last 7 days" />
            </div>
        </div>
    </section>

    <div class="grid-2">
        <section class="panel" aria-labelledby="flow-title">
            <div class="panel-head">
                <div>
                    <h2 id="flow-title">Cash in and cash out</h2>
                    <p class="sub">Last 14 days</p>
                </div>
                <div class="chart-legend">
                    <span><i class="dot in" aria-hidden="true"></i>Cash in</span>
                    <span><i class="dot out" aria-hidden="true"></i>Cash out</span>
                </div>
            </div>
            <div class="panel-body">
                <VolumeChart Days="fortnight" />
                @{
                    var busiest = fortnight.OrderByDescending(d => d.Volume).FirstOrDefault();
                }
                <div class="chart-summary">
                    <span>14-day volume <strong>@Cedis(fortnight.Sum(d => d.Volume))</strong></span>
                    <span>Cash in <strong>@Cedis(fortnight.Sum(d => d.CashIn))</strong></span>
                    <span>Cash out <strong>@Cedis(fortnight.Sum(d => d.CashOut))</strong></span>
                    @if (busiest is not null && busiest.Volume > 0)
                    {
                        <span>Busiest <strong>@busiest.Day.ToString("ddd d MMM")</strong></span>
                    }
                </div>
            </div>
        </section>

        <section class="panel" aria-labelledby="where-title">
            <div class="panel-head">
                <div>
                    <h2 id="where-title">Where the money is</h2>
                    <p class="sub">Cash, and float on each network</p>
                </div>
                <a href="/float">Manage →</a>
            </div>
            <div class="panel-body">
                @{
                    var places = new List<(string Key, string Name, decimal Amount)> { ("cash", "Cash", CashInHand) };
                    places.AddRange(Networks.All.Select(n => (NetworkKey(n), NetworkName(n), FloatOn(n))));
                    var widest = Math.Max(1m, places.Max(p => Math.Max(0m, p.Amount)));
                }
                @* A bar per place, each with its name and figure in text beside it: the network
                   colours are close for some colour-blind readers, so the words carry identity. *@
                <ul class="holdings-bars">
                    @foreach (var place in places)
                    {
                        <li class="@(place.Amount < 0 ? "negative" : "")">
                            <span class="hb-name"><i class="dot @place.Key" aria-hidden="true"></i>@place.Name</span>
                            <span class="hb-val">@Cedis(place.Amount)</span>
                            <span class="hb-track" aria-hidden="true">
                                <span class="hb-fill fill-@place.Key" style="width: @(((double)(Math.Max(0m, place.Amount) / widest) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </span>
                            @if (place.Amount < 0)
                            {
                                <span class="hb-note">Below zero — usually a transaction on the wrong network, or float given and not recorded.</span>
                            }
                        </li>
                    }
                </ul>
                <div class="hb-total"><span class="muted">Total</span><strong>@Cedis(TotalOnHand)</strong></div>
            </div>
        </section>
    </div>

    <div class="grid-2">
        <section class="panel" aria-labelledby="agents-title">
            <div class="panel-head">
                <div>
                    <h2 id="agents-title">Agents today</h2>
                    <p class="sub">Trading, holdings and day close</p>
                </div>
                <a href="/team">Team →</a>
            </div>
            @if (_holdings.Count == 0)
            {
                <p class="empty">Nobody has been added yet. Add workers on the <a href="/team">Team</a> page.</p>
            }
            else
            {
                <div class="scroll">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Agent</th>
                                <th scope="col" class="n">Transactions</th>
                                <th scope="col" class="n">Volume</th>
                                <th scope="col" class="n">Cash</th>
                                <th scope="col" class="n">Float</th>
                                <th scope="col">Closing</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var person in _holdings.OrderByDescending(h => _agentVolume.GetValueOrDefault(h.AgentId)).ThenBy(h => h.AgentName))
                        {
                            var floatTotal = person.Floats.Sum(f => f.Amount);
                            var (closeLabel, closeTone) = CloseState(person.AgentId);
                            <tr>
                                <td data-label="Agent">
                                    <span class="who-cell">
                                        <span class="avatar" aria-hidden="true">@Initials(person.AgentName)</span>
                                        <span><a class="name" href="@($"/agents/{person.AgentId}")">@person.AgentName</a><span class="sub">@person.BranchName</span></span>
                                    </span>
                                </td>
                                <td class="n" data-label="Transactions">@_agentCount.GetValueOrDefault(person.AgentId)</td>
                                <td class="n" data-label="Volume">@Cedis(_agentVolume.GetValueOrDefault(person.AgentId))</td>
                                <td class="n" data-label="Cash">@Cedis(person.Cash)</td>
                                <td class="n" data-label="Float"><span class="@(floatTotal < 0 ? "error" : "")">@Cedis(floatTotal)</span></td>
                                <td data-label="Closing"><span class="pill @closeTone">@closeLabel</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel" aria-labelledby="latest-title">
            <div class="panel-head">
                <div>
                    <h2 id="latest-title">Latest transactions</h2>
                    <p class="sub">@TodayCount.ToString("N0") today</p>
                </div>
                <a href="/transactions?period=Today">View all →</a>
            </div>
            @if (_latest.Count == 0)
            {
                <p class="empty">No transactions yet today. They appear here as agents record them.</p>
            }
            else
            {
                <ul class="feed">
                    @foreach (var t in _latest)
                    {
                        var incoming = t.CashDelta >= 0;
                        <li>
                            <span class="net-badge @NetworkKey(t.Network)" aria-hidden="true">@NetworkShort(t.Network)</span>
                            <span class="what">
                                <span class="kind">@Describe(t.Type)</span>
                                <span class="meta">
                                    @if (t.CustomerPhoneNumber?.Any(char.IsDigit) == true)
                                    {
                                        @GhanaPhoneNumber.Display(t.CustomerPhoneNumber)<text> · </text>
                                    }
                                    @AgentName(t.AgentId) · @t.TransactionAt.ToLocalTime().ToString("HH:mm")
                                </span>
                            </span>
                            @* Signed by the cash it moved, which is what the agent's till felt. *@
                            <span class="amount @(incoming ? "in" : "out")">@(incoming ? "+" : "−")@Cedis(t.Amount)</span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    @* Housekeeping, not news. *@
    <p class="estate-line muted">
        @_summary.TotalBranches @Plural(_summary.TotalBranches, "branch", "branches") ·
        @_summary.ActiveDevices active @Plural(_summary.ActiveDevices, "phone", "phones") ·
        @_summary.ActiveSessions open @Plural(_summary.ActiveSessions, "session", "sessions")
    </p>
}

@code {
    /// <summary>How often the page reloads. Long enough not to churn, short enough to act on.</summary>
    private const int RefreshSeconds = 60;

    /// <summary>How many of today's transactions to read for the direction split.</summary>
    /// <remarks>
    /// Bounded, because an unbounded read of a busy estate's day is how a dashboard becomes
    /// the slowest page in the product. Ten pages of the service's 200 is far above any single
    /// agent business's day, and when it is exceeded the page says so rather than presenting a
    /// partial split as the whole.
    /// </remarks>
    private const int MaxPagesForSplit = 10;

    private DashboardSummaryDto? _summary;
    private IReadOnlyList<Zazi.Application.Closing.DayCloseResult> _closes = [];
    private IReadOnlyList<string> _notClosed = [];
    private int _floatRequests;
    private decimal _monthCosts;
    private IReadOnlyList<AgentHoldingsDto> _holdings = Array.Empty<AgentHoldingsDto>();
    private List<TransactionDto> _latest = new();
    private IReadOnlyList<Zazi.Application.Growth.DailyActivity> _series = [];
    private readonly Dictionary<Guid, int> _agentCount = new();
    private readonly Dictionary<Guid, decimal> _agentVolume = new();
    private decimal _cashInTotal, _cashOutTotal;
    private int _cashInCount, _cashOutCount, _scanned;
    private long _todayTotal;
    private bool _splitIsPartial;
    private bool _failed;
    private DateTimeOffset _readAt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The organization comes from the signed-in principal, never from the URL or a
            // form field, so a caller cannot ask for another tenant's figures. A branch-scoped
            // manager sees their branch's people and transactions, not the whole estate's.
            var organizationId = CurrentUser.OrganizationId;
            var branchId = CurrentUser.HasOrganizationWideScope ? null : CurrentUser.BranchId;

            _summary = await Dashboard.GetOrganizationDashboardAsync(organizationId);
            _holdings = await Float.GetHoldingsAsync(organizationId, branchId);

            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            _closes = await Closes.ForDayAsync(organizationId, branchId, today);
            _notClosed = await Closes.NotClosedAsync(organizationId, branchId, today);
            _floatRequests = (await FloatRequests.PendingAsync(organizationId, branchId)).Count;
            _series = await Insights.DailyAsync(organizationId, branchId, 31);
            _monthCosts = (await Costs.ProfitAsync(organizationId, branchId,
                new DateOnly(today.Year, today.Month, 1), today)).Expenses;

            // Ghana keeps UTC all year, so the UTC day is the business day.
            var dayStart = new DateTimeOffset(DateTimeOffset.UtcNow.Date, TimeSpan.Zero);
            var page = 1;
            PagedResult<TransactionDto> result;
            do
            {
                result = await Transactions.GetTransactionsAsync(
                    new TransactionQuery(organizationId, branchId, page, 200, FromUtc: dayStart));

                if (page == 1)
                {
                    _latest = result.Items.Take(8).ToList();
                    _todayTotal = result.TotalCount;
                }

                foreach (var t in result.Items)
                {
                    _scanned++;
                    if (t.Type is TransactionType.CashIn or TransactionType.CashOut)
                    {
                        _agentCount[t.AgentId] = _agentCount.GetValueOrDefault(t.AgentId) + 1;
                        _agentVolume[t.AgentId] = _agentVolume.GetValueOrDefault(t.AgentId) + t.Amount;
                    }
                    if (t.Type == TransactionType.CashIn) { _cashInTotal += t.Amount; _cashInCount++; }
                    else if (t.Type == TransactionType.CashOut) { _cashOutTotal += t.Amount; _cashOutCount++; }
                }

                page++;
            }
            while (result.HasMore && page <= MaxPagesForSplit);

            _splitIsPartial = result.HasMore;

            // Stamped after the reads return, so it is the age of these figures rather than
            // the age of the request.
            _readAt = DateTimeOffset.Now;
        }
        catch (Exception)
        {
            // Reported as unavailable rather than rendered as zeroes. A dashboard showing a
            // confident ₵0.00 for a branch that traded all day is worse than one that admits
            // it could not read.
            _failed = true;
        }
    }

    /// <summary>
    /// Total float on one network across everyone shown. A sum of the ledger's own balances,
    /// not a balance computed here — the page still cannot disagree with what moved.
    /// </summary>
    private decimal FloatOn(string network) => _holdings
        .SelectMany(h => h.Floats)
        .Where(f => string.Equals(f.Network, network, StringComparison.OrdinalIgnoreCase))
        .Sum(f => f.Amount);

    // Every figure follows the viewer's scope. A branch manager's float tiles are their
    // branch's, so cash and trading must be too — the organisation-wide summary beside them
    // would put two scopes on one screen and invite adding them up.
    private bool BranchScoped => !CurrentUser.HasOrganizationWideScope;

    private decimal CashInHand => BranchScoped ? _holdings.Sum(h => h.Cash) : _summary!.CashPosition;

    private long TodayCount => BranchScoped ? _todayTotal : _summary!.TodayTransactions;

    private decimal TodayVolume => BranchScoped ? _cashInTotal + _cashOutTotal : _summary!.TodayVolume;

    private decimal TotalOnHand => CashInHand + Networks.All.Sum(FloatOn);

    private static string NetworkKey(string network) => network.ToUpperInvariant() switch
    {
        "MTN" => "mtn",
        "TELECEL" => "telecel",
        "AIRTELTIGO" => "airteltigo",
        _ => "other"
    };

    private static string NetworkShort(string network) => network.ToUpperInvariant() switch
    {
        "MTN" => "MTN",
        "TELECEL" => "T",
        "AIRTELTIGO" => "AT",
        _ => "·"
    };

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant()
        };
    }

    /// <summary>Where an agent stands on today's close, as a label and a tone.</summary>
    private (string Label, string Tone) CloseState(Guid agentId)
    {
        var close = _closes.FirstOrDefault(c => c.AgentId == agentId);
        if (close is not null)
        {
            return close.Status switch
            {
                "Balanced" => ("Balanced", "ok"),
                "Baseline" => ("First count", "ok"),
                "Short" => ("Short", "bad"),
                _ => ("Over", "warn")
            };
        }

        return _agentCount.GetValueOrDefault(agentId) > 0 ? ("Not closed", "warn") : ("No trading", "");
    }

    private static string Tone(decimal amount) => amount < 0 ? "negative" : amount == 0 ? "empty" : "";

    private string AgentName(Guid agentId) =>
        _holdings.FirstOrDefault(h => h.AgentId == agentId)?.AgentName ?? "Unknown";

    private static string Describe(TransactionType type) => type switch
    {
        TransactionType.CashIn => "Cash in",
        TransactionType.CashOut => "Cash out",
        TransactionType.Adjustment => "Cash or float given",
        _ => type.ToString()
    };

    private static string NetworkName(string network) => network.ToUpperInvariant() switch
    {
        "MTN" => "MTN",
        "TELECEL" => "Telecel",
        "AIRTELTIGO" => "AirtelTigo",
        _ => network
    };

    private static string Plural(long count, string one, string many) => count == 1 ? one : many;

    private string? _firstName;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var name = state.User.Identity?.Name?.Trim();
        _firstName = string.IsNullOrWhiteSpace(name) ? null : name.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
    }

    // Ghana keeps GMT all year, so the UTC hour is the local hour. Written without a relational
    // pattern: Razor reads "< 12" inside a code block as the start of an HTML tag.
    private static string Greeting()
    {
        var hour = DateTimeOffset.UtcNow.Hour;
        if (hour >= 17) return "Good evening";
        if (hour >= 12) return "Good afternoon";
        return "Good morning";
    }

    private string FirstName() => _firstName is null ? string.Empty : ", " + _firstName;

    private static string Cedis(decimal value) =>
        value < 0 ? $"−₵{Math.Abs(value):N2}" : $"₵{value:N2}";
}
