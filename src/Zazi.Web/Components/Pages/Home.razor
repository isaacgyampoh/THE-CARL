@page "/"
@using Zazi.Application
@using Zazi.Application.Security
@inject IDashboardService Dashboard
@inject ICurrentUserContext CurrentUser

<PageTitle>Today · Zazi</PageTitle>

@* A full page refresh, deliberately, rather than an interactive circuit with a timer.
   Revocation is enforced in RevokedSessionValidator, which runs when the cookie is
   validated — that is, on each HTTP request. A Blazor circuit establishes its principal
   once and holds it, so a revoked owner's open dashboard would go on serving live figures
   for as long as the circuit lived. Reloading keeps that guarantee intact: every refresh is
   a real request, and a revoked session is signed out on the next one.

   Only this page. Operations and Held are paged and filtered, and reloading them would
   throw away where the reader had got to. *@
<HeadContent>
    <meta http-equiv="refresh" content="@RefreshSeconds" />
</HeadContent>

<h1>Today</h1>

@if (_failed)
{
    <p class="error" role="alert">
        The dashboard could not be loaded. Nothing has been changed.
    </p>
}
else if (_summary is null)
{
    <p class="muted">Loading…</p>
}
else
{
    @* A dashboard that cannot say when it was read invites being trusted as live. These
       are figures someone may act on, so the page says how old they are. *@
    <p class="muted asof">
        Updated @_readAt.ToString("HH:mm:ss") · refreshes every @RefreshSeconds seconds ·
        <a href="/">refresh now</a>
    </p>

    <section class="tiles">
        @* Balances are read from the server's ledger. This page never computes a balance of
           its own, so it cannot disagree with what the ledger says moved. *@
        <div class="tile">
            <span class="label">Cash position</span>
            <span class="value">@Money(_summary.CashPosition)</span>
        </div>
        <div class="tile">
            <span class="label">Network float</span>
            <span class="value">@Money(_summary.TotalNetworkFloat)</span>
        </div>
        <div class="tile">
            <span class="label">Transactions today</span>
            <span class="value">@_summary.TodayTransactions</span>
        </div>
        <div class="tile">
            <span class="label">Volume today</span>
            <span class="value">@Money(_summary.TodayVolume)</span>
        </div>
    </section>

    <section class="attention">
        <h2>Needs attention</h2>
        <ul>
            <li><span>Discrepancies</span><strong>@_summary.Discrepancies</strong></li>
            <li><span>Low float alerts</span><strong>@_summary.LowFloatAlerts</strong></li>
            <li>
                <span>Balance variance</span>
                @* Surfaced even when zero. A reconciliation figure that only appears when it
                   is bad teaches people that a blank screen means "not checked". *@
                <strong>@Money(_summary.BalanceVariance)</strong>
            </li>
        </ul>
    </section>

    <section class="estate">
        <h2>Estate</h2>
        <ul>
            <li><span>Branches</span><strong>@_summary.TotalBranches</strong></li>
            <li><span>Active devices</span><strong>@_summary.ActiveDevices</strong></li>
            <li><span>Active sessions</span><strong>@_summary.ActiveSessions</strong></li>
        </ul>
    </section>
}

@code {
    /// <summary>How often the page reloads. Long enough not to churn, short enough to act on.</summary>
    private const int RefreshSeconds = 60;

    private DashboardSummaryDto? _summary;
    private bool _failed;
    private DateTimeOffset _readAt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The organization comes from the signed-in principal, never from the URL or a
            // form field, so a caller cannot ask for another tenant's figures.
            _summary = await Dashboard.GetOrganizationDashboardAsync(CurrentUser.OrganizationId);
            // Stamped after the read returns, so it is the age of these figures rather than
            // the age of the request.
            _readAt = DateTimeOffset.Now;
        }
        catch (Exception)
        {
            // Reported as unavailable rather than rendered as zeroes. A dashboard showing a
            // confident ₵0.00 for a branch that traded all day is worse than one that admits
            // it could not read.
            _failed = true;
        }
    }

    private static string Money(decimal value) => $"₵{value:N2}";
}
