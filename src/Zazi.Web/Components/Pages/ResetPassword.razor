@page "/reset-password"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.RateLimiting
@using Zazi.Application.Security
@using Zazi.Web.Security
@attribute [AllowAnonymous]
@attribute [EnableRateLimiting(WebRateLimitPolicies.Authentication)]
@inject IPasswordResetService Reset

@* The other end of the link. Anonymous by necessity — the person cannot sign in, which is why
   they are here. *@

<PageTitle>Choose a new password · Zazi</PageTitle>

<div class="signin">
    <h1>Zazi</h1>

    @if (_changed)
    {
        <p class="subtitle">Password changed</p>
        <p>
            Your password has been updated and every device that was signed in has been signed
            out. Sign in again with the new password.
        </p>
        <p><a href="/sign-in">Sign in</a></p>
    }
    else if (_state == PasswordResetTokenState.Expired)
    {
        <p class="subtitle">That link has expired</p>
        <p>Reset links are short-lived for safety. Request a new one and we will send another.</p>
        <p><a href="/forgot-password">Request a new link</a></p>
    }
    else if (_state != PasswordResetTokenState.Valid)
    {
        <p class="subtitle">That link did not work</p>
        @* One message for a token that never existed, one already used, and one replaced by a
           later request. Telling them apart would only help someone trying links they were
           never sent. *@
        <p>
            It may already have been used, or replaced by a newer link. Request a new one to
            continue.
        </p>
        <p><a href="/forgot-password">Request a new link</a> · <a href="/sign-in">Sign in</a></p>
    }
    else
    {
        <p class="subtitle">Choose a new password</p>

        <EditForm Model="_input" OnValidSubmit="SubmitAsync" FormName="reset-password">
    @* No <AntiforgeryToken /> here. EditForm with a FormName emits one itself, and adding a
       second renders the hidden field twice — which posts the value twice, so the framework
       reads "token,token" and rejects the submission with a 400. A plain <form>, like the one
       on the sign-in page, does need the explicit tag. *@
            <label for="password">New password</label>
            <InputText id="password" @bind-Value="_input.Password" type="password"
                       autocomplete="new-password" />
            <p class="muted">@PasswordPolicy.Requirement</p>

            <label for="confirm">Confirm new password</label>
            <InputText id="confirm" @bind-Value="_input.Confirm" type="password"
                       autocomplete="new-password" />

            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }

            <button type="submit" disabled="@_busy">Change password</button>
        </EditForm>

        <p class="muted">Changing your password signs you out everywhere.</p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordInput _input { get; set; } = new();

    private PasswordResetTokenState _state = PasswordResetTokenState.InvalidOrAlreadyUsed;
    private bool _changed;
    private bool _busy;
    private string? _error;

    // Checked on load so an unusable link is refused before anyone is asked to think of a
    // password. Deliberately does not consume the token: a page load is not a reset, and mail
    // clients that prefetch links must not burn it before its owner clicks.
    protected override async Task OnInitializedAsync()
    {
        if (!_changed)
        {
            _state = await Reset.InspectTokenAsync(Token ?? string.Empty);
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            if (_input.Password != _input.Confirm)
            {
                // Checked here rather than in the service: it is about what was typed into this
                // form, not about the account, and it must not cost the person their token.
                _error = "Those passwords do not match.";
                return;
            }

            var result = await Reset.ResetPasswordAsync(Token ?? string.Empty, _input.Password ?? string.Empty);

            switch (result.Outcome)
            {
                case PasswordResetOutcome.Changed:
                    _changed = true;
                    break;

                case PasswordResetOutcome.PasswordRejected:
                    // The token survives, so they can simply try a stronger password.
                    _error = result.Problem;
                    _state = PasswordResetTokenState.Valid;
                    break;

                case PasswordResetOutcome.Expired:
                    _state = PasswordResetTokenState.Expired;
                    break;

                default:
                    _state = PasswordResetTokenState.InvalidOrAlreadyUsed;
                    break;
            }
        }
        finally
        {
            _input = new ResetPasswordInput();
            _busy = false;
        }
    }

    private sealed class ResetPasswordInput
    {
        public string? Password { get; set; }
        public string? Confirm { get; set; }
    }
}
