@page "/sign-up"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using Zazi.Application.Onboarding
@using Zazi.Application.Security
@attribute [AllowAnonymous]
@inject ISignUpService Onboarding
@inject IOptions<SignUpOptions> Options

@* Where a business opens its own account. Static server rendering and a plain form post:
   nothing here needs a circuit, and a page that people reach before they have an account is
   the worst place to depend on a WebSocket connecting. *@

<PageTitle>Create an account · Zazi</PageTitle>

<div class="signin">
    @* The mark and the name, not a heading. These pages are reached by someone who is
       often locked out, on a phone, in a hurry — the product identity reassures them they
       are in the right place, but the heading below is what tells them what this page does.
       "Zazi" as the h1 said the same thing on all six of them. *@
    <div class="masthead">
        <ZaziMark Size="24" />
        <span class="wordmark">Zazi</span>
    </div>

    @if (!Options.Value.Enabled)
    {
        <h1 class="purpose">Accounts are not open</h1>
        <p>
            This Zazi deployment does not accept self-service signups. Ask whoever runs it to
            create an account for you.
        </p>
        <p><a href="/sign-in">Back to sign in</a></p>
    }
    else if (_submitted)
    {
        <h1 class="purpose">Check your email</h1>
        <p>
            If that address can receive mail, a confirmation link is on its way to
            <strong>@_sentTo</strong>. Open it to finish setting up your account.
        </p>
        <p class="muted">The link works once and expires in 24 hours.</p>

        @if (_emailFailed)
        {
            @* Said plainly rather than hidden. The account exists; what failed was the sending,
               and telling someone to check an inbox that will stay empty wastes their evening. *@
            <p class="error" role="alert">
                We could not send the email just now. Your account was created — use the button
                below to try sending the link again.
            </p>
        }

        <EditForm Model="_resend" OnValidSubmit="ResendAsync" FormName="resend-verification">
    @* No <AntiforgeryToken /> here. EditForm with a FormName emits one itself, and adding a
       second renders the hidden field twice — which posts the value twice, so the framework
       reads "token,token" and rejects the submission with a 400. A plain <form>, like the one
       on the sign-in page, does need the explicit tag. *@
            <InputText id="resend-email" @bind-Value="_resend.Email" type="hidden" />
            <button type="submit" disabled="@_busy">Send the link again</button>
        </EditForm>

        @if (_resent)
        {
            <p class="muted" role="status">Sent. It can take a minute to arrive.</p>
        }

        <p><a href="/sign-in">Back to sign in</a></p>
    }
    else
    {
        <h1 class="purpose">Create your account</h1>

        <EditForm Model="_input" OnValidSubmit="SubmitAsync" FormName="sign-up">
            <label for="business">Business name</label>
            <InputText id="business" @bind-Value="_input.BusinessName" autocomplete="organization" />

            <label for="name">Your full name</label>
            <InputText id="name" @bind-Value="_input.FullName" autocomplete="name" />

            <label for="email">Email</label>
            <InputText id="email" @bind-Value="_input.Email" type="email" autocomplete="email" />

            <label for="phone">Phone number <span class="muted">(optional)</span></label>
            <InputText id="phone" @bind-Value="_input.PhoneNumber" type="tel" autocomplete="tel" />

            <label for="password">Password</label>
            <InputText id="password" @bind-Value="_input.Password" type="password"
                       autocomplete="new-password" />
            <p class="muted">@PasswordPolicy.Requirement</p>

            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }

            <button type="submit" disabled="@_busy">Create account</button>
        </EditForm>

        <p>Already have an account? <a href="/sign-in">Sign in</a></p>
    }
</div>

@code {
    // [SupplyParameterFromForm] rather than a plain field: static rendering means the whole
    // component is rebuilt from scratch on the POST, so anything the person typed is gone
    // unless the framework rehydrates it from the form.
    [SupplyParameterFromForm(FormName = "sign-up")]
    private SignUpInput _input { get; set; } = new();

    [SupplyParameterFromForm(FormName = "resend-verification")]
    private ResendInput _resend { get; set; } = new();

    private bool _submitted;
    private bool _emailFailed;
    private bool _resent;
    private bool _busy;
    private string? _error;
    private string? _sentTo;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var result = await Onboarding.SignUpAsync(new SignUpRequest(
                _input.BusinessName ?? string.Empty,
                _input.FullName ?? string.Empty,
                _input.Email ?? string.Empty,
                _input.Password ?? string.Empty,
                string.IsNullOrWhiteSpace(_input.PhoneNumber) ? null : _input.PhoneNumber));

            _submitted = true;
            _sentTo = _input.Email;
            _resend.Email = _input.Email;
            _emailFailed = result.Outcome == SignUpOutcome.CreatedButEmailFailed;

            // The password does not survive this page. It is in the database as a hash and
            // has no further use here.
            _input = new SignUpInput();
        }
        catch (ArgumentException ex)
        {
            // Validation only. ArgumentException from this service is always about what was
            // typed, and its message is written to be read by the person who typed it.
            _error = ex.Message.Split(" (Parameter")[0];
        }
        catch (InvalidOperationException)
        {
            _error = "Accounts are not open on this deployment.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendAsync()
    {
        _busy = true;
        try
        {
            await Onboarding.ResendVerificationAsync(_resend.Email ?? string.Empty);

            // Always reported the same way, whether or not anything was sent. The service will
            // not say either, for the same reason: this must not become a way to test which
            // addresses have accounts.
            _submitted = true;
            _sentTo = _resend.Email;
            _resent = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class SignUpInput
    {
        public string? BusinessName { get; set; }
        public string? FullName { get; set; }
        public string? Email { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Password { get; set; }
    }

    private sealed class ResendInput
    {
        public string? Email { get; set; }
    }
}
