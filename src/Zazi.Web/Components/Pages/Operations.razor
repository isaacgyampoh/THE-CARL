@page "/operations"
@using Zazi.Application
@using Zazi.Application.Security
@attribute [Authorize(Policy = ZaziPolicies.OrganizationRead)]
@inject IObservabilityService Observability
@inject ICurrentUserContext CurrentUser
@inject IHttpClientFactory HttpClients
@inject IConfiguration Configuration

<PageTitle>Operations · Zazi</PageTitle>

<h1>Operations</h1>

@* What is actually running, and whether its parts are answering. An incident starts here:
   the build, the database, and the API the handsets talk to. *@
<section class="panel" aria-labelledby="system-title">
    <div class="panel-head">
        <div>
            <h2 id="system-title">System</h2>
            <p class="sub">Checked when this page was opened</p>
        </div>
        <span class="pill @(_systemHealthy ? "ok" : "bad")">@(_systemHealthy ? "All answering" : "Check needed")</span>
    </div>
    <div class="panel-body flush">
        <div class="scroll">
            <table>
                <thead>
                    <tr><th scope="col">Part</th><th scope="col">State</th><th scope="col">Detail</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-label="Part">Portal</td>
                        <td data-label="State"><span class="pill ok">Running</span></td>
                        <td data-label="Detail">@Zazi.Application.BuildInfo.Version · commit @Zazi.Application.BuildInfo.Commit</td>
                    </tr>
                    <tr>
                        <td data-label="Part">Database</td>
                        <td data-label="State"><span class="pill @(_databaseUp ? "ok" : "bad")">@(_databaseUp ? "Reachable" : "Unreachable")</span></td>
                        <td data-label="Detail">@(_databaseUp ? "Answered a query for this page" : "The portal could not read from it")</td>
                    </tr>
                    <tr>
                        <td data-label="Part">API (the handsets)</td>
                        <td data-label="State"><span class="pill @(_apiState == "healthy" ? "ok" : _apiState == "unknown" ? "warn" : "bad")">@ApiStateLabel</span></td>
                        <td data-label="Detail">@_apiDetail</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@if (_failed)
{
    <p class="error" role="alert">Operations data could not be loaded.</p>
}
else if (_health is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <section class="tiles">
        <div class="tile @(_health.ErrorsLastHour > 0 ? "bad" : "")">
            <span class="label">Errors, last hour</span>
            <span class="value">@_health.ErrorsLastHour</span>
        </div>
        <div class="tile">
            <span class="label">Errors, last day</span>
            <span class="value">@_health.ErrorsLastDay</span>
        </div>
        <div class="tile @(_health.HeldEvidenceCount > 0 ? "warn" : "")">
            <span class="label">Held for review</span>
            <span class="value">@_health.HeldEvidenceCount</span>
        </div>
        <div class="tile @(_health.StaleDevices > 0 ? "warn" : "")">
            <span class="label">Devices not reporting</span>
            <span class="value">@_health.StaleDevices</span>
        </div>
        <div class="tile">
            <span class="label">Active devices</span>
            <span class="value">@_health.ActiveDevices / @_health.TotalDevices</span>
        </div>
    </section>

    <h2>Recurring failures (last 7 days)</h2>
    @if (_errorGroups.Count == 0)
    {
        <p class="muted">No failures recorded.</p>
    }
    else
    {
        @* Grouped rather than listed: fifty copies of one broken endpoint is one problem. *@
        <div class="scroll">
            <table>
                <thead>
                <tr><th>Error</th><th>Where</th><th class="n">Count</th><th class="n">Devices</th><th>Last seen</th></tr>
                </thead>
                <tbody>
                @foreach (var group in _errorGroups)
                {
                    <tr>
                        <td data-label="Error"><code>@group.ErrorCode</code><span class="sub">@group.SampleDetails</span></td>
                        <td data-label="Where">@group.Action<span class="sub">@group.Source</span></td>
                        <td class="n" data-label="Count"><strong>@group.Occurrences</strong></td>
                        <td class="n" data-label="Devices">@group.AffectedDevices</td>
                        <td data-label="Last seen">@Ago(group.LastSeen)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <h2>Devices</h2>
    @if (_devices.Count == 0)
    {
        @* Every other section here says when it has nothing. Without this the heading was
           followed by an empty table, which on a phone — where the header row is hidden —
           renders as a heading with literally nothing under it. *@
        <p class="muted">No phones have been activated yet.</p>
    }
    else
    {
    <div class="scroll">
        <table>
            <thead>
            <tr><th>Device</th><th>Version</th><th>Last seen</th><th class="n">Failures (24h)</th><th>State</th></tr>
            </thead>
            <tbody>
            @foreach (var device in _devices)
            {
                <tr class="@(device.IsRevoked ? "muted-row" : device.IsStale ? "warn-row" : "")">
                    <td data-label="Device">@device.Name<span class="sub">@device.DeviceType</span></td>
                    <td data-label="Version">@device.AppVersion<span class="sub">@device.OsVersion</span></td>
                    <td data-label="Last seen">@Ago(device.LastSeenAtUtc)</td>
                    <td class="n" data-label="Failures (24h)">@device.RecentFailureCount</td>
                    <td data-label="State">
                        @if (device.IsRevoked)
                        {
                            <span class="pill bad">Revoked</span>
                        }
                        else if (device.IsStale)
                        {
                            <span class="pill warn">Not reporting</span>
                        }
                        else
                        {
                            <span class="pill ok">@device.Status</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    }


    <h2>Recent events</h2>
    @if (_events.Count == 0)
    {
        <p class="muted">Nothing recorded yet.</p>
    }
    else
    {
        <div class="scroll">
            <table class="log">
                <thead>
                <tr><th>Time</th><th>Severity</th><th>Event</th><th>Source</th><th>Trace</th></tr>
                </thead>
                <tbody>
                @foreach (var item in _events)
                {
                    <tr>
                        <td data-label="Time">@item.OccurredAt.ToLocalTime().ToString("HH:mm:ss")<span class="sub">@item.OccurredAt.ToLocalTime().ToString("dd MMM")</span></td>
                        <td data-label="Severity"><span class="pill @SeverityClass(item.Severity)">@item.Severity</span></td>
                        <td data-label="Event">@item.Action<span class="sub">@item.Details</span></td>
                        <td data-label="Source">@item.Source</td>
                        <td data-label="Trace">
                            @* The correlation id is the thread through the whole incident. *@
                            @if (!string.IsNullOrWhiteSpace(item.CorrelationId))
                            {
                                <a href="/operations/trace/@item.CorrelationId">timeline</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool _databaseUp;
    private string _apiState = "unknown";
    private string _apiDetail = "Not checked";

    private bool _systemHealthy => _databaseUp && _apiState == "healthy";

    private string ApiStateLabel => _apiState switch
    {
        "healthy" => "Answering",
        "unknown" => "Not checked",
        _ => "Not answering"
    };

    /// <summary>
    /// Asks the API the same question a load balancer does. Failure here is information, not
    /// an error: the portal keeps working when the API is down, and the owner should be told
    /// which half is unwell.
    /// </summary>
    private async Task CheckSystemAsync()
    {
        _databaseUp = _health is not null;

        var apiUrl = Configuration["Api:PublicBaseUrl"];
        if (string.IsNullOrWhiteSpace(apiUrl))
        {
            _apiState = "unknown";
            _apiDetail = "No API address configured for this portal";
            return;
        }

        try
        {
            using var client = HttpClients.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(5);
            using var response = await client.GetAsync($"{apiUrl.TrimEnd('/')}/health");
            if (!response.IsSuccessStatusCode)
            {
                _apiState = "down";
                _apiDetail = $"Answered {(int)response.StatusCode}";
                return;
            }

            using var document = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            var root = document.RootElement;
            _apiState = "healthy";
            _apiDetail = root.TryGetProperty("version", out var version) && root.TryGetProperty("commit", out var commit)
                ? $"{version.GetString()} · commit {commit.GetString()}"
                : "Answering";
        }
        catch (Exception)
        {
            _apiState = "down";
            _apiDetail = "No answer inside five seconds";
        }
    }

    private SystemHealthDto? _health;
    private IReadOnlyList<ErrorGroupDto> _errorGroups = Array.Empty<ErrorGroupDto>();
    private IReadOnlyList<DeviceHealthDto> _devices = Array.Empty<DeviceHealthDto>();
    private IReadOnlyList<ObservabilityEventDto> _events = Array.Empty<ObservabilityEventDto>();
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The organization comes from the signed-in principal, never from the URL.
            var organizationId = CurrentUser.OrganizationId;

            _health = await Observability.GetSystemHealthAsync(organizationId);
            _errorGroups = await Observability.GetErrorGroupsAsync(
                organizationId, DateTimeOffset.UtcNow.AddDays(-7));
            _devices = await Observability.GetDeviceHealthAsync(organizationId);

            var recent = await Observability.GetRecentEventsAsync(
                organizationId, new EventQuery(Page: 1, PageSize: 25));
            _events = recent.Items;
        }
        catch (Exception)
        {
            // Reported as unavailable rather than rendered as zeroes: an operations screen
            // that silently shows "no errors" when it cannot read is worse than a blank one.
            _failed = true;
        }

        // Outside the try: whether the rest of the page loaded is itself the signal for the
        // database row, and a failure to reach the API must not blank the page.
        await CheckSystemAsync();
    }

    private static string SeverityClass(string severity) => severity switch
    {
        "Error" => "bad",
        "Warning" => "warn",
        _ => "ok"
    };

    private static string Ago(DateTimeOffset when)
    {
        var elapsed = DateTimeOffset.UtcNow - when;
        if (elapsed < TimeSpan.FromMinutes(1)) return "just now";
        if (elapsed < TimeSpan.FromHours(1)) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed < TimeSpan.FromDays(1)) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }
}
