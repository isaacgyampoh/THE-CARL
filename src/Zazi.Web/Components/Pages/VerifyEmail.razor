@page "/verify-email"
@using Microsoft.AspNetCore.Authorization
@using Zazi.Application.Onboarding
@attribute [AllowAnonymous]
@inject ISignUpService SignUp

@* The other end of the link in the verification email. Anonymous by necessity: the whole
   point is that the person cannot sign in until this has run. *@

<PageTitle>Confirm your email · Zazi</PageTitle>

<div class="signin">
    @* The mark and the name, not a heading. These pages are reached by someone who is
       often locked out, on a phone, in a hurry — the product identity reassures them they
       are in the right place, but the heading below is what tells them what this page does.
       "Zazi" as the h1 said the same thing on all six of them. *@
    <div class="masthead">
        <ZaziMark Size="24" />
        <span class="wordmark">Zazi</span>
    </div>

    @switch (_outcome)
    {
        case EmailVerificationOutcome.Verified:
            <h1 class="purpose">Email confirmed</h1>
            <p>Your account is ready. Sign in to set up your business.</p>
            <p><a href="/sign-in">Sign in</a></p>
            break;

        case EmailVerificationOutcome.Expired:
            <h1 class="purpose">That link has expired</h1>
            <p>
                Verification links last 24 hours. Request a new one and we will send another.
            </p>
            <p><a href="/sign-up">Request a new link</a></p>
            break;

        default:
            <h1 class="purpose">That link did not work</h1>
            @* One message for a token that never existed, one already used, and one whose
               account is gone. Distinguishing them would only help someone trying tokens they
               were never sent. *@
            <p>
                It may already have been used, or it may have been mistyped. If you have
                already confirmed, just sign in.
            </p>
            <p><a href="/sign-in">Sign in</a> · <a href="/sign-up">Request a new link</a></p>
            break;
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private EmailVerificationOutcome _outcome = EmailVerificationOutcome.InvalidOrAlreadyUsed;

    // OnInitializedAsync, so the token is redeemed while the page is being built and the
    // result is what renders. Static rendering means this runs exactly once per request,
    // which matters for something that is deliberately single-use.
    protected override async Task OnInitializedAsync()
    {
        var result = await SignUp.VerifyEmailAsync(Token ?? string.Empty);
        _outcome = result.Outcome;
    }
}
