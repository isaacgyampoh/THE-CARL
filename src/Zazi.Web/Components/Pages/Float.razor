@page "/float"
@using System.Globalization
@using Zazi.Application
@using Zazi.Application.Float
@using Zazi.Application.Growth
@using Zazi.Application.Security
@attribute [Authorize(Policy = ZaziPolicies.BranchManage)]
@inject IFloatService Floats
@inject IAlertService Alerts
@inject IFloatRequestService FloatRequests
@inject ICurrentUserContext CurrentUser
@inject NavigationManager Navigation
@inject ILogger<Float> Log

@* Static server rendering, deliberately: giving an agent money is the one thing on this page
   that must not depend on a live connection to the browser. These are ordinary form posts, so
   they work on a weak connection, with JavaScript blocked, and after the page has been open
   all morning. Each submission carries a token, so pressing "Record" twice records once. *@

<PageTitle>Cash and float · Zazi</PageTitle>

<header class="page-head">
    <div>
        <h1>Cash and float</h1>
        <p class="lead">
            What each person is holding right now. Cash is notes in their hand; float is e-money
            on their phone, counted separately for each network.
        </p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Problem))
{
    <p class="error" role="alert">@Problem</p>
}
else if (!string.IsNullOrWhiteSpace(Done))
{
    <p role="status">@Done</p>
}

@if (_requests.Count > 0)
{
    @* Agents asking for float. Giving it here records it against them in the same step, so the
       float given and the request cannot disagree. *@
    <h2>Float requests</h2>
    <ul class="requests">
        @foreach (var request in _requests)
        {
            <li>
                <span class="net-badge @NetworkKey(request.Network)" aria-hidden="true">@NetworkShort(request.Network)</span>
                <span class="rq-what">
                    <strong>@request.AgentName</strong> asks for <strong>@Money(request.Amount)</strong> @NetworkName(request.Network)
                    <span class="sub">@request.RequestedAtUtc.ToLocalTime().ToString("d MMM HH:mm") · by @(request.Channel == "SMS" ? "SMS" : "the app") · code @request.Code</span>
                </span>
                <span class="rq-actions">
                    <form method="post" @formname="@($"answer-{request.Id}")" @onsubmit="() => DecideAsync(request.Id, true)">
                        <AntiforgeryToken />
                        <button type="submit" class="approve">Give float</button>
                    </form>
                    <form method="post" @formname="@($"decline-{request.Id}")" @onsubmit="() => DecideAsync(request.Id, false)">
                        <AntiforgeryToken />
                        <button type="submit" class="decline">Decline</button>
                    </form>
                </span>
            </li>
        }
    </ul>
}

<h2>Who is holding what</h2>
@if (_holdings.Count == 0)
{
    <p class="empty">Nobody has been added yet. Add workers on the <a href="/team">Team</a> page.</p>
}
else
{
    <div class="scroll">
        <table>
            <thead>
                <tr>
                    <th scope="col">Person</th>
                    <th scope="col">Branch</th>
                    <th scope="col" class="n">Cash</th>
                    <th scope="col" class="n">Float</th>
                    <th scope="col" class="n">Total</th>
                    <th scope="col">Float by network</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var holding in _holdings)
            {
                <tr>
                    <td data-label="Person">
                        @* Their ledger: what they hold, what moved today, and why. *@
                        <a href="@($"/agents/{holding.AgentId}")">@holding.AgentName</a>
                    </td>
                    <td data-label="Branch">@holding.BranchName</td>
                    <td class="n" data-label="Cash">@Money(holding.Cash)</td>
                    <td class="n" data-label="Float">@Money(holding.TotalFloat)</td>
                    <td class="n" data-label="Total"><strong>@Money(holding.Cash + holding.TotalFloat)</strong></td>
                    <td data-label="Float by network">
                        @if (holding.Floats.Count == 0)
                        {
                            <span class="muted">none</span>
                        }
                        else
                        {
                            <div class="chips">
                            @foreach (var f in holding.Floats)
                            {
                                <span class="float-chip @(f.Amount < 0 ? "negative" : "")">
                                    <span class="net">@NetworkName(f.Network)</span>
                                    <span class="amt">@f.Amount.ToString("N2")</span>
                                </span>
                            }
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2>Give cash or float</h2>

<EditForm Model="Give" FormName="give-float" OnValidSubmit="GiveAsync">
    <input type="hidden" name="Give.Token" value="@Give.Token" />

    <p class="muted">
        Enter what you handed over. Use a negative amount to record money taken back at the end
        of a shift.
    </p>

    <p>
        <label for="agent">Person</label>
        <InputSelect id="agent" @bind-Value="Give.AgentId">
            <option value="">Choose someone…</option>
            @foreach (var holding in _holdings)
            {
                <option value="@holding.AgentId">@holding.AgentName</option>
            }
        </InputSelect>
    </p>

    <p>
        <label for="network">Network <span class="muted">(for the float)</span></label>
        <InputSelect id="network" @bind-Value="Give.Network">
            <option value="MTN">MTN</option>
            <option value="TELECEL">Telecel</option>
            <option value="AIRTELTIGO">AirtelTigo</option>
        </InputSelect>
    </p>

    <p>
        <label for="cash">Cash given (GHS)</label>
        <InputNumber id="cash" @bind-Value="Give.Cash" step="0.01" inputmode="decimal" />
    </p>

    <p>
        <label for="efloat">Float given (GHS)</label>
        <InputNumber id="efloat" @bind-Value="Give.EFloat" step="0.01" inputmode="decimal" />
    </p>

    <p>
        <label for="note">Note <span class="muted">(optional)</span></label>
        <InputText id="note" @bind-Value="Give.Note" />
    </p>

    <button type="submit">Record</button>
</EditForm>

<h2>Low float warning</h2>

<EditForm Model="Warning" FormName="float-warning" OnValidSubmit="SaveWarningAsync">

    <p class="muted">
        Set the level at which an agent's float counts as low. Agents on keypad phones are told
        in the reply to each transaction — no extra SMS — and the Today page counts who is low.
    </p>

    <p>
        <label for="warn-network">Network</label>
        <InputSelect id="warn-network" @bind-Value="Warning.Network">
            <option value="MTN">MTN</option>
            <option value="TELECEL">Telecel</option>
            <option value="AIRTELTIGO">AirtelTigo</option>
        </InputSelect>
    </p>

    <p>
        <label for="warn-level">Warn when float is below (GHS)</label>
        <InputNumber id="warn-level" @bind-Value="Warning.Level" step="1" inputmode="decimal" />
    </p>

    <button type="submit">Save warning</button>
</EditForm>

@code {
    [SupplyParameterFromQuery(Name = "done")] private string? Done { get; set; }
    [SupplyParameterFromQuery(Name = "problem")] private string? Problem { get; set; }

    [SupplyParameterFromForm(FormName = "give-float")] private GiveInput Give { get; set; } = new();
    [SupplyParameterFromForm(FormName = "float-warning")] private WarningInput Warning { get; set; } = new();

    private IReadOnlyList<AgentHoldingsDto> _holdings = [];
    private IReadOnlyList<FloatRequestDto> _requests = [];

    private sealed class GiveInput
    {
        public string? AgentId { get; set; }
        public string Network { get; set; } = "MTN";
        public decimal Cash { get; set; }
        public decimal EFloat { get; set; }
        public string? Note { get; set; }

        /// <summary>One attempt to record, so a second press of the button records nothing new.</summary>
        public string Token { get; set; } = Guid.NewGuid().ToString("N");
    }

    private sealed class WarningInput
    {
        public string Network { get; set; } = "MTN";
        public decimal Level { get; set; } = 500m;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var branch = CurrentUser.VisibleBranchId();
            _holdings = await Floats.GetHoldingsAsync(CurrentUser.OrganizationId, branch);
            _requests = await FloatRequests.PendingAsync(CurrentUser.OrganizationId, branch);
        }
        catch (Exception exception)
        {
            Log.LogError(exception, "Loading holdings failed.");
            Problem = "Holdings could not be loaded. Please try again.";
        }
    }

    private async Task GiveAsync()
    {
        if (!Guid.TryParse(Give.AgentId, out var agentId))
        {
            Back(problem: "Choose who the money was given to.");
            return;
        }

        if (Give.Cash == 0m && Give.EFloat == 0m)
        {
            Back(problem: "Enter an amount of cash, float, or both.");
            return;
        }

        // The outcome is decided first and the redirect issued after: redirecting is signalled
        // by an exception, and a catch-all around it would report a successful save as a failure.
        string? done = null;
        string? problem = null;
        try
        {
            await Floats.RecordFloatAsync(
                new RecordFloatRequest(agentId, Give.Network, Give.Cash, Give.EFloat, Give.Note, Give.Token),
                CurrentUser.OrganizationId,
                CurrentUser.UserId);

            var name = _holdings.FirstOrDefault(h => h.AgentId == agentId)?.AgentName ?? "the agent";
            done = $"Recorded for {name}: cash {Money(Give.Cash)}, {NetworkName(Give.Network)} float {Money(Give.EFloat)}.";
        }
        catch (ArgumentException invalid)
        {
            // Validation messages are written to be read by the person who typed the values.
            problem = invalid.Message.Split(" (Parameter")[0];
        }
        catch (KeyNotFoundException missing)
        {
            problem = missing.Message;
        }
        catch (Exception exception)
        {
            Log.LogError(exception, "Recording float failed.");
            problem = "That could not be recorded. Nothing was saved. Please try again.";
        }

        Back(done, problem);
    }

    private async Task DecideAsync(Guid requestId, bool approve)
    {
        string? done = null;
        string? problem = null;
        try
        {
            var decided = await FloatRequests.DecideAsync(
                CurrentUser.OrganizationId, requestId, approve, CurrentUser.UserId, "Portal");
            done = approve
                ? $"{Money(decided.Amount)} {NetworkName(decided.Network)} float recorded for {decided.AgentName}."
                : $"Request from {decided.AgentName} declined.";
        }
        catch (FloatRequestRejectedException rejected)
        {
            problem = rejected.Message;
        }
        catch (Exception exception)
        {
            Log.LogError(exception, "Answering a float request failed.");
            problem = "That could not be done. Please try again.";
        }

        Back(done, problem);
    }

    private async Task SaveWarningAsync()
    {
        if (Warning.Level <= 0m || Warning.Level > 1_000_000m)
        {
            Back(problem: "Enter a level above zero.");
            return;
        }

        string? done = null;
        string? problem = null;
        try
        {
            await Alerts.SetThresholdAsync(new AlertThresholdRequest(
                CurrentUser.OrganizationId,
                CurrentUser.HasOrganizationWideScope ? null : CurrentUser.BranchId,
                Warning.Network,
                decimal.Round(Warning.Level, 2),
                decimal.Round(Warning.Level / 2m, 2)));

            done = $"Agents will be warned when {NetworkName(Warning.Network)} float is below {Money(Warning.Level)}.";
        }
        catch (Exception exception)
        {
            Log.LogError(exception, "Saving the float warning failed.");
            problem = "The warning could not be saved. Please try again.";
        }

        Back(done, problem);
    }

    /// <summary>
    /// Back to the page as a fresh request, carrying what happened. A redirect rather than a
    /// re-render: the figures are then read after the write, and a browser refresh repeats the
    /// reading rather than the recording.
    /// </summary>
    private void Back(string? done = null, string? problem = null)
    {
        var query = done is not null
            ? "?done=" + Uri.EscapeDataString(done)
            : problem is not null ? "?problem=" + Uri.EscapeDataString(problem) : string.Empty;
        Navigation.NavigateTo("/float" + query);
    }

    private static string Money(decimal value) =>
        value < 0 ? $"−₵{Math.Abs(value).ToString("N2", CultureInfo.InvariantCulture)}" : $"₵{value.ToString("N2", CultureInfo.InvariantCulture)}";

    private static string NetworkName(string network) => network.ToUpperInvariant() switch
    {
        "MTN" => "MTN",
        "TELECEL" => "Telecel",
        "AIRTELTIGO" => "AirtelTigo",
        _ => network
    };

    private static string NetworkKey(string network) => network.ToUpperInvariant() switch
    {
        "MTN" => "mtn", "TELECEL" => "telecel", "AIRTELTIGO" => "airteltigo", _ => "other"
    };

    private static string NetworkShort(string network) => network.ToUpperInvariant() switch
    {
        "MTN" => "MTN", "TELECEL" => "T", "AIRTELTIGO" => "AT", _ => "·"
    };
}
