<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. Applies the development network security config so the app can
  reach a local backend over the emulator's host loopback. Release builds never see this, so
  they retain Android's default cleartext block.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />

</manifest>
