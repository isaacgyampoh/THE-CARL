<?xml version="1.0" encoding="utf-8"?>
<!--
  Pilot-only manifest overlay. Applies the pilot network security config so a minified,
  signed build can reach a backend on the local network over plain HTTP. Release builds never
  see this and retain Android's default cleartext block.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />

</manifest>
