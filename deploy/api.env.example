# Zazi API production configuration.
#
#   Copy to /etc/zazi/api.env, fill in the two REQUIRED values, then:
#     sudo chown root:root /etc/zazi/api.env && sudo chmod 600 /etc/zazi/api.env
#
# Never commit the filled-in version. This file is a template and holds no secrets.

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Without either of these the API refuses to start. That is deliberate: a Zazi that
# starts without a database or without a signing key is worse than one that does not
# start, because it accepts transactions and discards them.

# Two underscores, and DefaultConnection — not Default. ConnectionStrings__Default is
# silently ignored and the API then has no database at all.
#
# Host=127.0.0.1 keeps PostgreSQL on loopback. Add SSL Mode=Require only if the database
# is on a different machine; for a same-VM database it adds nothing over loopback.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=zazi;Username=zazi;Password=CHANGE_ME

# At least 32 bytes. Generate one with:  openssl rand -base64 48
#
# Zazi.Web must be given the SAME value: it issues cookies from tokens the API signed,
# and a mismatch means every sign-in on the dashboard fails with no useful message.
ZAZI_JWT_KEY=CHANGE_ME

# ─── REQUIRED FOR A SINGLE-SERVER DEPLOYMENT ─────────────────────────────────

# Applies pending EF migrations at startup.
#
# Defaults to OFF in Production — not on. The API then refuses to start while migrations
# are pending, and on a fresh server every migration is pending, so without this line the
# first start fails.
#
# Set it to true for a single-API-process deployment, which is this one. The race the
# default guards against — two instances migrating the same database at once — cannot
# happen with one process. install.sh writes this line for you.
#
# Leave it out only if you run more than one API process, and then migrate as a separate
# deployment step before rolling out.
Database__MigrateOnStartup=true

# ─── NOT HERE: the email credential ──────────────────────────────────────────
#
# RESEND_API_KEY belongs in /etc/zazi/web.env and nowhere else. The API sends no email;
# signup and verification are the dashboard's. Copying the key here would widen what a
# leak of this file costs, for nothing in return.
#
# If the API ever does need to send, the variable is the same name and the same rules:
# environment only, never appsettings.json, never the repository.

# ─── SET BY THE SYSTEMD UNIT — do not put these here ─────────────────────────
#
#   ASPNETCORE_URLS=http://127.0.0.1:5055    binds to loopback only
#   ASPNETCORE_ENVIRONMENT=Production
#   Zazi__BehindTlsProxy=true                TLS is terminated by Caddy
#
# Setting them here as well would work, but it splits one decision across two files.

# ─── DEVELOPMENT ONLY — must never appear in production ──────────────────────
#
#   ASPNETCORE_ENVIRONMENT=Development
#     Generates an ephemeral JWT signing key when none is configured, and relaxes the
#     transport checks. In production the absence of a key is a startup failure, which
#     is the behaviour you want.
