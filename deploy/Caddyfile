# Caddy terminates TLS and forwards to the two Zazi processes on loopback.
#
# The domain is not written here. Caddy substitutes {$ZAZI_DOMAIN} from the environment, so
# this file is the same on every deployment and the domain lives in one place —
# /etc/default/caddy. See docs/PRODUCTION.md.
#
# Requires Caddy 2.7 or newer for `trusted_proxies` and `client_ip_headers`.

{
	servers {
		# ── The client IP, and why this block is load-bearing ──────────────────
		#
		# With Cloudflare in front the request chain is:
		#
		#     agent's phone → Cloudflare edge → Caddy → Zazi
		#
		# Caddy appends the address it received from to X-Forwarded-For, which is a
		# Cloudflare edge server. Zazi's ForwardedHeaders middleware trusts one hop
		# and takes the last entry, so without this it would treat the Cloudflare
		# edge as the client.
		#
		# That is not cosmetic. Zazi rate limits sign-in and device activation per
		# IP address. Every agent routed through the same Cloudflare point of
		# presence would share one bucket: ten attempts a minute between all of
		# them. One person mistyping a password locks out a whole city, and a real
		# attacker spreading attempts across PoPs is limited barely at all.
		#
		# trusted_proxies says which peers may speak for someone else, and
		# client_ip_headers says which header to believe from them. Caddy then
		# resolves {client_ip} to the phone's real address.
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

		client_ip_headers CF-Connecting-IP
	}
}

# ── The API. The only thing a handset ever contacts. ─────────────────────────
api.{$ZAZI_DOMAIN} {
	reverse_proxy 127.0.0.1:5055 {
		# The real client, not the Cloudflare edge. See the note above.
		header_up X-Forwarded-For {client_ip}
		# Zazi refuses to start unless it is told TLS is terminated ahead of it, and
		# it decides a request was secure from this header.
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /var/log/caddy/api.log
	}
}

# ── The owner dashboard. Blazor Server. ──────────────────────────────────────
app.{$ZAZI_DOMAIN} {
	reverse_proxy 127.0.0.1:5056 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto {scheme}

		# Blazor Server holds a SignalR WebSocket open for the life of a signed-in
		# session. Caddy upgrades WebSockets without configuration, but it will cut
		# an idle stream at the default read timeout, and a dashboard left open on a
		# desk is idle for long stretches. The visible symptom is a page that
		# reconnects every few minutes, which reads as a flaky network rather than a
		# timeout.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /var/log/caddy/app.log
	}
}

# Caddy redirects HTTP to HTTPS on its own for any site it serves, so there is no
# http:// block here. Cloudflare must be set to Full (strict), not Flexible — see
# docs/PRODUCTION.md for why Flexible produces an endless redirect.
