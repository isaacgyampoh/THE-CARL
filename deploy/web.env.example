# Copy to /etc/zazi/web.env, fill in, then: sudo chmod 600 /etc/zazi/web.env
#
# Two underscores, and DefaultConnection — not Default. ConnectionStrings__Default is silently
# ignored. The API refuses to start rather than falling back to an in-memory store, so a typo
# here fails loudly instead of accepting transactions and discarding them.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=zazi;Username=zazi;Password=CHANGE_ME

# At least 32 random bytes. Generate with: openssl rand -base64 48
# Zazi.Web must be given the SAME value.
ZAZI_JWT_KEY=CHANGE_ME
