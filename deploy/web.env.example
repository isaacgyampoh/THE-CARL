# Zazi dashboard production configuration.
#
#   Copy to /etc/zazi/web.env, fill in the two REQUIRED values, then:
#     sudo chown root:root /etc/zazi/web.env && sudo chmod 600 /etc/zazi/web.env

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# The same database the API uses. The dashboard reads it directly rather than calling
# the API.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=zazi;Username=zazi;Password=CHANGE_ME

# Must be byte-for-byte the SAME value as the API's ZAZI_JWT_KEY.
#
# If they differ, the dashboard cannot validate what the API signed. Sign-in fails with
# a generic rejection and nothing in the logs points at the cause, which is a long
# afternoon.
ZAZI_JWT_KEY=CHANGE_ME

# ─── TRANSACTIONAL EMAIL (Resend) ────────────────────────────────────────────
#
# Required for self-service signup, because an account is not usable until the person
# has proved they own the address. Leave both lines out and the dashboard still starts
# and still runs; it simply reports every send as failed rather than pretending.
#
# Set BOTH or NEITHER. Email__Provider=Resend with no key is a startup failure, on
# purpose: a deployment that thinks it can send email and cannot leaves people waiting
# for a message that is never coming, and nothing in the logs says why.
#
# Before this works, getzazi.com must be verified at https://resend.com/domains, which
# means adding the DKIM, SPF and MX records it gives you. In Cloudflare those records
# must be DNS-only (grey cloud) — proxying a TXT or MX record breaks verification.
# docs/PRODUCTION.md has the full list.
#
#Email__Provider=Resend

# The key itself, and the only place it may ever be written. Not appsettings.json, not
# the repository, not a Razor component, not a log line. The application reads this
# variable directly rather than through configuration, so that a key committed to a
# settings file would not work even if someone put one there.
#
# Create it at https://resend.com/api-keys with Sending access only — a full-access key
# can read every message this domain has ever sent, and the dashboard only needs to post.
#
#RESEND_API_KEY=re_CHANGE_ME

# ─── PUBLIC URL ──────────────────────────────────────────────────────────────
#
# How customers reach this dashboard. Every link Zazi emails is built from it.
#
# Read from configuration and NEVER from the request's Host header. These links activate
# accounts and change passwords; one assembled from a header the caller chose is one an
# attacker aims at a site they control.
#
# Required for password reset, and required before signup can be enabled. Without it the
# portal still starts and still works — password reset simply tells people to contact an
# administrator instead of pretending to send mail.
#
Portal__PublicBaseUrl=https://app.getzazi.com

# ─── PASSWORD RESET ──────────────────────────────────────────────────────────
#
# On whenever Portal__PublicBaseUrl and email are both configured. There is deliberately no
# switch: someone who has forgotten their password needs a way back in whether or not this
# deployment accepts new signups.
#
# Defaults are 30 minutes validity, a 2-minute gap between requests for one account, and a
# 900ms floor on the response. The floor is a security control, not a delay to tune away —
# without it, response time reveals whether an address has an account, which is the one
# thing the identical on-screen message exists to hide.
#
#PasswordReset__ValidForMinutes=30
#PasswordReset__RequestCooldownMinutes=2
#PasswordReset__MinimumResponseMilliseconds=900

# ─── SELF-SERVICE SIGNUP ─────────────────────────────────────────────────────
#
# Whether strangers may create their own Zazi accounts. Off unless set, because opening a
# financial system to public registration is a decision to make deliberately — a pilot
# running with a handful of known agents has no reason to accept accounts from anyone who
# finds the URL.
#
# Requires working email and Portal__PublicBaseUrl above. A signup that cannot send its
# verification link creates accounts nobody can open, so the portal refuses to start if
# this is set without them.
#
#SignUp__Enabled=true

# ─── SET BY THE SYSTEMD UNIT — do not put these here ─────────────────────────
#
#   ASPNETCORE_URLS=http://127.0.0.1:5056
#   ASPNETCORE_ENVIRONMENT=Production
#   Zazi__BehindTlsProxy=true
#   Zazi__DataProtectionKeyPath=/var/lib/zazi/keys
#
# The key path matters more than it looks. It holds the keys that encrypt session
# cookies and antiforgery tokens. Lose that directory and every signed-in owner is
# signed out; it is on the backup list in docs/PRODUCTION.md for that reason.

# ─── DEVELOPMENT ONLY — must never appear in production ──────────────────────
#
#   ASPNETCORE_ENVIRONMENT=Development
#     Permits an ephemeral data-protection key ring in memory. In production a missing
#     key path is a startup failure instead.
